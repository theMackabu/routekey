{
   "$schema": "https://biomejs.dev/schemas/1.9.2/schema.json",

   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },

   "files": {
      "ignoreUnknown": false,
      "ignore": []
   },

   "formatter": {
      "enabled": true,
      "indentWidth": 3,
      "lineWidth": 150,
      "indentStyle": "space"
   },

   "organizeImports": {
      "enabled": true
   },

   "linter": {
      "enabled": true,
      "rules": { "recommended": true }
   },

   "javascript": {
      "formatter": {
         "trailingCommas": "none",
         "bracketSpacing": true,
         "bracketSameLine": true,
         "quoteStyle": "single",
         "semicolons": "always",
         "quoteProperties": "asNeeded",
         "arrowParentheses": "asNeeded"
      }
   }
}
